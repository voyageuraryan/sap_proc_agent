# Copy to .env and fill in. Never commit .env itself.
#
# Provider credentials. LiteLLM reads these from the environment directly, so
# they never enter a Python settings object that could be logged or serialised.
ANTHROPIC_API_KEY=sk-ant-...

# Mock ERP service (env_prefix MOCK_ERP_)
MOCK_ERP_ERP_DATA_DIR=data/erp
MOCK_ERP_DB_PATH=data/approvals.sqlite3

# Agent (env_prefix AGENT_). All optional -- defaults live in AgentSettings.
AGENT_ERP_BASE_URL=http://localhost:8000/sap/opu/odata/sap/ZPROC_SRV
AGENT_MODEL=anthropic/claude-sonnet-4-5
AGENT_MAX_ITERATIONS=8
AGENT_TEMPERATURE=0.0

# Tracing. Leave AGENT_TRACING=true: with no backend configured it costs
# nothing and builds no spans. A local file needs no account at all:
#   AGENT_TRACE_FILE=traces/run.jsonl
AGENT_TRACING=true
AGENT_TRACE_ENVIRONMENT=local
# AGENT_TRACE_RELEASE=<git sha>          # so a CI trace is distinguishable
# AGENT_TRACE_PAYLOADS=false             # drop prompts/tool results from spans

# Langfuse. BOTH keys must be set or the backend is skipped entirely --
# a half-configured client prints an auth error and silently disables itself.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
